# Sicherheits-Header für alle Seiten
/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: SAMEORIGIN
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=()

# Schriften ändern sich nie → lange zwischenspeichern
/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Bilder einen Tag zwischenspeichern (neue Fotos mit gleichem Namen sind spätestens am Folgetag sichtbar)
/img/*
  Cache-Control: public, max-age=86400

# Inhaber-Verwaltung: nie zwischenspeichern, nicht in Suchmaschinen, strenge Sicherheitsregeln
/admin
  Cache-Control: no-store
  X-Robots-Tag: noindex, nofollow
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'; object-src 'none'
